{
  "name": "@jellylegsai/aether-validator-cli",
  "version": "1.4.0",
  "description": "Aether Validator CLI - tiered validators (Full/Lite/Observer), system checks, onboarding, staking, and node management",
  "main": "index.js",
  "bin": {
    "aether": "./index.js",
    "aether-cli": "./index.js",
    "aether-hub": "./index.js",
    "jelly-aether": "./index.js"
  },
  "files": [
    "index.js",
    "commands/",
    "sdk/",
    "test/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/doctor.test.js",
    "start": "node index.js",
    "doctor": "node index.js doctor",
    "postinstall": "node -e \"console.log('\\n\\n  [Aether] aether-validator-cli installed!\\n\\n  Run: aether start\\n  Docs: https://github.com/jelly-legs-ai/Jelly-legs-unsteady-workshop\\n')\""
  },
  "keywords": [
    "aether",
    "validator",
    "blockchain",
    "cli",
    "crypto",
    "mining"
  ],
  "author": "Jelly-legs AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jelly-legs-ai/Jelly-legs-unsteady-workshop.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "preferGlobal": true,
  "dependencies": {
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  }
