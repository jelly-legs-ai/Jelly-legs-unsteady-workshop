[workspace]
members = [
    "crates/aether-core",
    "crates/aether-consensus",
    "crates/aether-ai-priority",
    "crates/aether-privacy",
    "crates/aether-governance",
    "crates/aether-common",
]
resolver = "2"

[workspace.package]
version = "0.1.0"
authors = ["AETHER Development Team <dev@aether.network>"]
edition = "2021"
license = "Apache-2.0"
repository = "https://github.com/jelly-legs-ai/Jelly-legs-unsteady-workshop"
rust-version = "1.70"

[workspace.dependencies]
# Core dependencies
solana-sdk = "1.17.0"
solana-program = "1.17.0"
solana-runtime = "1.17.0"
solana-poh = "1.17.0"
solana-ledger = "1.17.0"
solana-gossip = "1.17.0"
solana-streamer = "1.17.0"

# Crypto
ed25519-dalek = "2.0"
sha2 = "0.10"
blake3 = "1.5"

# Async
tokio = { version = "1.35", features = ["full"] }
async-trait = "0.1"
futures = "0.3"

# Serialization
serde = { version = "1.0", features = ["derive"] }
bincode = "1.3"
borsh = "0.10"

# Logging
tracing = "0.1"
tracing-subscriber = "0.3"
log = "0.4"

# Error handling
thiserror = "1.0"
anyhow = "1.0"

# Testing
[profile.test]
opt-level = 2

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
