name: 🤖 AI Team Orchestrator v4

on:
  schedule:
    - cron: '*/7 * * * *'  # Every 7 minutes
  workflow_dispatch:  # Manual trigger

jobs:
  orchestrate:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      issues: write
      pull-requests: write
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          fetch-depth: 0
          
      - name: Setup Git
        run: |
          git config --local user.email "jelly-legs@autonomous.ai"
          git config --local user.name "Jelly-Legs AI"
          
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          registry-url: 'https://registry.npmjs.org/'
          
      - name: Configure npm for publishing
        run: |
          echo "//registry.npmjs.org/:_authToken=${{ secrets.NPM_TOKEN }}" >> ~/.npmrc 2>/dev/null || true
          echo "registry=https://registry.npmjs.org/" >> ~/.npmrc 2>/dev/null || true
          
      - name: Install dependencies
        run: npm install --ignore-scripts 2>/dev/null || true
        continue-on-error: true
        
      - name: Run AI Team Orchestrator v4
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO_OWNER: ${{ github.repository_owner }}
          REPO_NAME: ${{ github.event.repository.name }}
          OPENCLAW_URL: ${{ secrets.OPENCLAW_URL }}
        run: node scripts/orchestrator-v4.js
